<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmallConvert</AssemblyName>
    <RootNamespace>SmallConvert</RootNamespace>
    <Version>2.0.0</Version>
    <!-- Enables Word COM automation on Windows; ignored on other platforms -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Cross-platform: no RuntimeIdentifier here; see publish.sh / publish.cmd -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UI -->
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.1.3" />

    <!-- Conversion -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="13.9.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.4" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

</Project>
